#!/usr/bin/env bash
# strata — the single front door for every Strata command.
#
# Skills invoke `strata <command> [args]` — bare on PATH after `strata link`
# (or `"${CLAUDE_PLUGIN_ROOT}/bin/strata"` when Claude Code substitutes that).
# The point is legibility: a vault write should read as an intention-revealing,
# obviously-Strata command in the transcript — `strata procedure --title "..."`
# — not as arbitrary Python script execution. It stays a visible Bash call (so
# Claude Code still surfaces and permission-gates it, and there is still no
# write *tool* over MCP for a prompt injection to call); it just stops looking
# scary.
#
# Mechanics: shell-only commands (link, root, opencode-setup) run inline and
# exit. Python commands map <command> to scripts/<x>.py and exec through
# run-python.sh, which owns venv bootstrap, env resolution, and stdin passthrough
# (note bodies still arrive on stdin via the caller's heredoc).
set -euo pipefail

# Resolve symlinks so `strata` works when invoked via ~/.local/bin/strata.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

sub="${1:-}"
shift || true

case "$sub" in
  # ---- shell-only (no Python) -------------------------------------------
  link)
    TARGET="${STRATA_LINK_TARGET:-$HOME/.local/bin/strata}"
    BIN_DIR="$(dirname "$TARGET")"
    mkdir -p "$BIN_DIR"
    ln -sf "$ROOT/bin/strata" "$TARGET"
    echo "strata: linked $TARGET → $ROOT/bin/strata" >&2
    case ":$PATH:" in
      *":$BIN_DIR:"*) ;;
      *) echo "strata: warning — $BIN_DIR is not on your PATH" >&2
         echo "         add it to your shell profile: export PATH=\"$BIN_DIR:\$PATH\"" >&2 ;;
    esac
    exit 0
    ;;
  root)
    echo "$ROOT"
    exit 0
    ;;
  opencode-setup)
    VAULT="${STRATA_VAULT_PATH:-$HOME/StrataVault}"
    SKILLS_DIR="$ROOT/opencode/skills"
    if [ ! -d "$SKILLS_DIR" ]; then
      echo "strata: opencode skills not found at $SKILLS_DIR" >&2
      echo "         run 'strata generate-opencode-skills' first" >&2
      exit 1
    fi
    cat <<OESCRIPT
Add this to ~/.config/opencode/opencode.json (deep-merge into existing keys):

{
  "mcp": {
    "strata": {
      "type": "local",
      "command": ["$ROOT/bin/run-python.sh", "$ROOT/mcp/server.py"],
      "enabled": true,
      "env": {
        "STRATA_VAULT_PATH": "$VAULT"
      }
    }
  },
  "skills": {
    "paths": ["$SKILLS_DIR"]
  }
}
OESCRIPT
    exit 0
    ;;
  zcode-setup)
    # zcode (Z.ai) runs the opencode-schema config at ~/.zcode/v2/config.json,
    # so the snippet is identical to opencode-setup — only the target file and
    # the deep-merge behaviour differ (v2 already holds a `provider` block).
    # See INSTALL.md "Installing for zcode".
    VAULT="${STRATA_VAULT_PATH:-$HOME/StrataVault}"
    SKILLS_DIR="$ROOT/opencode/skills"
    if [ ! -d "$SKILLS_DIR" ]; then
      echo "strata: skills not found at $SKILLS_DIR" >&2
      echo "         run 'strata generate-opencode-skills' first" >&2
      exit 1
    fi
    CONFIG="$HOME/.zcode/v2/config.json"

    # --apply: deep-merge the snippet into v2/config.json in place (preserving
    # the existing `provider` block). Bare invocation just prints the snippet.
    if [ "${1:-}" = "--apply" ]; then
      [ -f "$CONFIG" ] || { echo "strata: $CONFIG not found — is zcode installed?" >&2; exit 1; }
      python3 - "$CONFIG" "$ROOT" "$VAULT" "$SKILLS_DIR" <<'PYAPPLY'
import json, sys, pathlib
config_path, root, vault, skills = sys.argv[1:5]
cfg = json.loads(pathlib.Path(config_path).read_text())

# Merge — only set keys we own; never touch `provider` or anything else.
mcp = cfg.setdefault("mcp", {})
mcp["strata"] = {
    "type": "local",
    "command": [f"{root}/bin/run-python.sh", f"{root}/mcp/server.py"],
    "enabled": True,
    "env": {"STRATA_VAULT_PATH": vault},
}
skills_cfg = cfg.setdefault("skills", {})
paths = set(skills_cfg.get("paths", []))
paths.add(skills)
skills_cfg["paths"] = sorted(paths)

pathlib.Path(config_path).write_text(json.dumps(cfg, indent=2, ensure_ascii=False) + "\n")
print(f"strata: merged into {config_path}")
print(f"        mcp.strata → {root}/mcp/server.py")
print(f"        skills.paths += {skills}")
print("        restart zcode to load (it reads config once at startup).")
PYAPPLY
      exit 0
    fi

    cat <<ZESCRIPT
Add this to $CONFIG (deep-merge into existing keys — the \`provider\` block
stays untouched). Or run: strata zcode-setup --apply

{
  "mcp": {
    "strata": {
      "type": "local",
      "command": ["$ROOT/bin/run-python.sh", "$ROOT/mcp/server.py"],
      "enabled": true,
      "env": {
        "STRATA_VAULT_PATH": "$VAULT"
      }
    }
  },
  "skills": {
    "paths": ["$SKILLS_DIR"]
  }
}

Then restart zcode — it loads config once at startup.
ZESCRIPT
    exit 0
    ;;
  generate-opencode-skills)
    exec "$ROOT/bin/run-python.sh" "$ROOT/scripts/generate-opencode-skills.py" "$@"
    ;;
  # ---- writes (create / mutate vault notes) -----------------------------
  decide)            script="new-decision.py" ;;
  propose)           script="new-proposition.py" ;;
  procedure)         script="new-procedure.py" ;;
  domain)
    # The subcommand IS the scope — refuse a contradictory user-supplied
    # --scope rather than letting argparse's last-wins quietly reroute a
    # note that the transcript says went to domain/.
    for arg in "$@"; do
      if [ "$arg" = "--scope" ] || [[ "$arg" == --scope=* ]]; then
        echo "strata domain: --scope is implied (domain); use \`strata save --scope ...\` for other scopes" >&2
        exit 2
      fi
    done
    exec "$ROOT/bin/run-python.sh" "$ROOT/scripts/save-note.py" --scope domain "$@"
    ;;
  save)              script="save-note.py" ;;
  observe)           script="observe.py" ;;
  correct)           script="correct-note.py" ;;
  invalidate)        script="invalidate-note.py" ;;
  forget)            script="forget.py" ;;
  consolidate)       script="consolidate.py" ;;
  archive)           script="archive-merged.py" ;;
  archive-planning)  script="archive-planning.py" ;;
  promote-to-pr)     script="promote-to-pr.py" ;;
  export)            script="export-to-repo.py" ;;
  # ---- reads / inspection ----------------------------------------------
  find)              script="find.py" ;;
  review)            script="review.py" ;;
  dashboard)         script="dashboard.py" ;;
  doctor)            script="doctor.py" ;;
  audit-config)      script="audit-config.py" ;;
  lint)              script="memory-lint.py" ;;
  plan-correlate)    script="plan_correlate.py" ;;
  code-map)          script="code-map.py" ;;
  bootstrap-scan)    script="bootstrap-scan.py" ;;
  draft-snapshot)    script="draft-snapshot.py" ;;
  read-index)        script="read-index.py" ;;
  # ---- lifecycle / index ------------------------------------------------
  init)              script="init-memory.py" ;;
  sync)              script="git-sync.py" ;;
  prime)             script="prime-context.py" ;;
  reindex)           script="refresh-index.py" ;;
  graphify)          script="graphify-orchestrate.py" ;;
  eval)              script="eval.py" ;;
  # ---- meta -------------------------------------------------------------
  ""|-h|--help|help)
    cat >&2 <<'USAGE'
strata — Strata vault commands

Setup:
  link              install ~/.local/bin/strata symlink (enables bare `strata` on PATH)
  opencode-setup    print opencode.json config snippet for Strata MCP + skills
  zcode-setup       print zcode (~/.zcode/v2/config.json) snippet; --apply merges it in
  generate-opencode-skills  build opencode/skills/ from skills/ (shared by opencode + zcode)

Writes (visible, permission-gated; no write tool is exposed over MCP):
  decide            record an ADR (scripts/new-decision.py)
  propose           open a proposition / debate
  procedure         capture a procedural note
  domain            write a domain note (one concept per file; --overwrite to update)
  save              write a pr-context or lessons note
  observe           auto-capture a grounded observation (quarantined)
  correct           edit a note (with audit trail)
  invalidate        mark a note no longer current
  forget            move a note to .trash/ (user-only)
  consolidate       merge near-duplicate notes
  archive           move merged-PR context to archive/
  archive-planning  archive bootstrapped planning docs
  promote-to-pr     surface vault context in a PR
  export            copy a note into the host repo

Reads / inspection:
  find              literal-string vault search (fallback to the recall tool)
  review            vault health report
  dashboard         current vault state
  read-index        print the cached INDEX.md (quick dashboard read)
  draft-snapshot    build a save-draft from git session state
  doctor            install / health check
  audit-config      show active settings
  lint              secret / PII scan
  plan-correlate    cross-check a planning subdir vs git + graph
  code-map          token-budgeted code-graph projection
  bootstrap-scan    enumerate migration candidates

Lifecycle / index:
  init              one-time vault setup for a repo (--git makes the vault a git repo)
  sync              pull + push the git-backed vault (the ONLY network command)
  prime             re-emit the SessionStart context primer
  reindex           refresh the FTS index
  graphify          build / refresh the code graph
  eval              run the temporal benchmark

Shell-only:
  root              print the resolved plugin root (for prompt templates)
  link              create ~/.local/bin/strata symlink

Retrieval is the `recall` MCP tool, not a command here.
USAGE
    [ -z "$sub" ] && exit 2 || exit 0
    ;;
  *)
    echo "strata: unknown command '$sub' (try \`strata help\`)" >&2
    exit 2
    ;;
esac

exec "$ROOT/bin/run-python.sh" "$ROOT/scripts/$script" "$@"
